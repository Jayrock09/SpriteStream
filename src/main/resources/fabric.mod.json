{
  "schemaVersion": 1,
  "id": "spritestream",
  "version": "${version}",
  "name": "SpriteStream",
  "description": "Run huge texture packs (up to 2048x, including LabPBR/POM packs) inside a fixed VRAM budget. Block textures are kept at a small base resolution; the ones covering pixels on screen are streamed in at the resolution those pixels need.",
  "authors": ["Jayrock09"],
  "contact": {
    "homepage": "https://github.com/Jayrock09/SpriteStream",
    "sources": "https://github.com/Jayrock09/SpriteStream",
    "issues": "https://github.com/Jayrock09/SpriteStream/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/spritestream/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.spritestream.SpriteStreamMod"]
  },
  "mixins": ["spritestream.mixins.json"],
  "accessWidener": "spritestream.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.3",
    "java": ">=25",
    "sodium": ">=0.9.2 <0.10.0-"
  },
  "suggests": {
    "iris": ">=1.12.0-",
    "continuity": "*"
  }
}
